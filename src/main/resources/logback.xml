<?xml version="1.0" encoding="UTF-8"?>
<!--
  Journalisation volontairement discrète : le rapport part sur la sortie standard, les messages
  techniques sur l'erreur standard. Rediriger l'un n'emporte donc pas l'autre.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%-5level %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
